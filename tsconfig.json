{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "jsx": "react-jsx", "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["packages/*/**/*.ts", "packages/*/**/*.tsx"],
  "exclude": ["node_modules", "**/node_modules", "packages/create-game/template", "**/dist"]
}
