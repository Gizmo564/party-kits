{
  "name": "__SLUG__",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run two terminals:  npm run dev:server  (Worker + DO on :8787)   and   npm run dev:web  (Vite on :5173, proxies /api and /ws)\"",
    "dev:server": "npm run build -w @game/web && npm run dev -w @game/server",
    "dev:web": "npm run dev -w @game/web",
    "build": "npm run build -w @game/web",
    "typecheck": "npm run typecheck:engine && npm run typecheck:server && npm run typecheck:web",
    "typecheck:engine": "tsc -p packages/engine",
    "typecheck:server": "tsc -p packages/server",
    "typecheck:web": "tsc -p packages/web",
    "test": "vitest run",
    "deploy": "npm run build && npm run deploy -w @game/server",
    "e2e": "node scripts/e2e.mjs",
    "tv-check": "node scripts/tv-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4"
  },
  "dependencies": {
    "@gizmo564/audio": "^0.1.0",
    "@gizmo564/bots-away": "^0.1.0",
    "@gizmo564/cast": "^0.1.0",
