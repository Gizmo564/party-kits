    "@gizmo564/host-display": "^0.1.0",
    "@gizmo564/join-codes": "^0.1.0",
    "@gizmo564/lobby-host": "^0.1.0",
    "@gizmo564/lobby-ui": "^0.1.0",
    "@gizmo564/pass-the-phone": "^0.1.0",
    "@gizmo564/platform": "^0.1.0",
    "@gizmo564/room-client": "^0.1.0",
    "@gizmo564/room-server": "^0.1.0",
    "@gizmo564/rules-results": "^0.1.0",
    "@gizmo564/themes": "^0.1.0"
  }
