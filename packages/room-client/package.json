{
  "name": "@gizmo564/room-client",
  "version": "0.1.0",
  "description": "Browser side of a room: useRoom (websocket, rejoin token, reconnect, nap, closed), createRoom/roomInfo, join-link parsing, per-game storage, and the Room closed / reconnecting / nap notices.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./web/Notices": "./web/Notices.tsx",
    "./web/api": "./web/api.ts",
    "./web": "./web/index.ts",
    "./web/link": "./web/link.ts",
    "./web/storage": "./web/storage.ts",
    "./web/useRoom": "./web/useRoom.ts"
  },
  "files": [
    "**/*",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!test",
    "!testing",
    "!**/testing"
  ],
  "dependencies": {
    "@gizmo564/join-codes": "^0.1.0",
    "@gizmo564/room-server": "^0.1.0"
  },
